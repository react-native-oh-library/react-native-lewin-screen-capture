{
  "license": "MIT",
  "devDependencies": {
  },
  "author": "",
  "name": "@react-native-ohos/react-native-lewin-screen-capture",
  "description": "React Native 屏幕截屏组件（OpenHarmony/HarmonyOS 适配）：提供系统截屏事件监听（startListener）、主动截取当前屏幕（screenCapture）与截屏缓存清理（clearCache）能力，截图结果以 {code, uri, base64} 结构回调，可用于截屏分享、页面快照生成、敏感内容截屏检测等场景。",
  "main": "index.ets",
  "version": "1.1.0-beta.1",
  "dependencies": {
    "@rnoh/react-native-openharmony": "file:../react_native_openharmony_release.har"
  }
}
