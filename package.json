{
  "name": "@react-native-ohos/react-native-lewin-screen-capture",
  "version": "1.1.0-beta.1",
  "description": "Listen for system screenshot events and capture the current screen",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "react-native": "./src/index.js",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/LewinJun/react-native-lewin-screen-capture"
  },
  "keywords": [
    "react-native",
    "harmony",
    "ohos",
    "openharmony",
    "rnoh"
  ],
  "homepage": "https://github.com/LewinJun/react-native-lewin-screen-capture#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "harmony/",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "codegen-lib": "react-native codegen-lib-harmony --no-safety-check --npm-package-name lewin_screen_capture --cpp-output-path ./harmony/lewin_screen_capture/src/main/cpp/generated --ets-output-path ./harmony/lewin_screen_capture/src/main/ets/generated --turbo-modules-spec-paths ./src/specs/v1/NativeScreenCapture.ts",
    "test": "jest --config jest/jest.config.js --no-coverage",
    "test:coverage": "jest --config jest/jest.config.js --coverage"
  },
  "peerDependencies": {
    "react-native": ">=0.72"
  },
  "devDependencies": {
    "react": "18.2.0",
    "@types/react": "18.2.79",
    "react-native": "0.72.5",
    "jest": "^29.6.3",
    "babel-jest": "^29.6.3",
    "@babel/core": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "@babel/preset-flow": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@babel/plugin-transform-react-jsx": "^7.23.4",
    "@react-native-oh/react-native-harmony-cli": "^0.77.50",
    "metro": "^0.81.0"
  },
  "engines": {
    "node": ">=18"
  },
  "harmony": {
    "alias": "react-native-lewin-screen-capture",
    "autolinking": {
      "cmakeLibraryTargetName": "rnoh_lewin_screen_capture",
      "ohPackageName": "@react-native-ohos/react-native-lewin-screen-capture",
      "etsPackageClassName": "LewinScreenCapturePackage",
      "cppPackageClassName": "LewinScreenCapturePackage"
    }
  }
}
